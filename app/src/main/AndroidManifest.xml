<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools">

    <uses-permission android:name="android.permission.INTERNET" />
    <uses-permission android:name="android.permission.ACCESS_NETWORK_STATE" />
    <uses-permission android:name="android.permission.ACCESS_WIFI_STATE" />
    <uses-permission android:name="android.permission.CHANGE_WIFI_MULTICAST_STATE" />
    <uses-permission android:name="android.permission.KILL_BACKGROUND_PROCESSES" />
    <uses-permission android:name="android.permission.VIBRATE" />
    <uses-permission android:name="android.permission.REQUEST_DELETE_PACKAGES" />
    <uses-permission android:name="android.permission.REQUEST_INSTALL_PACKAGES" />
    <uses-permission
        android:name="android.permission.BLUETOOTH"
        android:maxSdkVersion="30" />
    <uses-permission
        android:name="android.permission.READ_EXTERNAL_STORAGE"
        android:maxSdkVersion="32" />
    <uses-permission
        android:name="android.permission.WRITE_EXTERNAL_STORAGE"
        android:maxSdkVersion="29" />
    <uses-permission
        android:name="android.permission.MANAGE_EXTERNAL_STORAGE"
        tools:ignore="ScopedStorage" />

    <!-- Android 11+ (API 30+) 软件包可见性声明：桌面应用 + 独立模拟器 + VIEW 协议 -->
    <queries>
        <intent>
            <action android:name="android.intent.action.MAIN" />
            <category android:name="android.intent.category.LAUNCHER" />
        </intent>
        <intent>
            <action android:name="android.intent.action.MAIN" />
            <category android:name="android.intent.category.LEANBACK_LAUNCHER" />
        </intent>
        <intent>
            <action android:name="android.intent.action.VIEW" />
            <data android:mimeType="*/*" />
        </intent>
        <!-- RetroArch -->
        <package android:name="com.retroarch" />
        <package android:name="com.retroarch.aarch64" />
        <package android:name="com.retroarch.ra32" />
        <!-- 常见独立模拟器（确保 Android 11+ 无 LAUNCHER 入口或跨区安装也可被识别） -->
        <package android:name="org.ppsspp.ppsspp" />
        <package android:name="org.ppsspp.ppssppgold" />
        <package android:name="com.dsemu.drastic" />
        <package android:name="me.magnum.melonds" />
        <package android:name="com.github.stenzek.duckstation" />
        <package android:name="com.epsxe.ePSXe" />
        <package android:name="com.emulator.fpse64" />
        <package android:name="com.emulator.fpse" />
        <package android:name="xyz.aethersx2.android" />
        <package android:name="com.nethersx2.emulator" />
        <package android:name="com.tahlreth.aethersx2" />
        <package android:name="org.dolphinemu.dolphinemu" />
        <package android:name="org.dolphinemu.handheld" />
        <package android:name="org.dolphinemu.mmjr" />
        <package android:name="org.dolphinemu.mmjr2" />
        <package android:name="org.mmjr.dolphinemu" />
        <package android:name="org.azahar_emu.azahar" />
        <package android:name="io.github.lime3ds.android" />
        <package android:name="org.citra.citra_emu" />
        <package android:name="org.citra.emu" />
        <package android:name="org.citra.citra_emu.canary" />
        <package android:name="dev.eden.eden_emulator" />
        <package android:name="org.citron.citron_emu" />
        <package android:name="org.sudachi.sudachi_emu" />
        <package android:name="org.yuzu.yuzu_emu" />
        <package android:name="dev.suyu.suyu_emu" />
        <package android:name="org.ryujinx.android" />
        <package android:name="info.cemu.cemu" />
        <package android:name="org.vita3k.emulator" />
        <package android:name="com.flycast.emulator" />
        <package android:name="io.recompiled.redream" />
        <package android:name="org.uoyabause.urern.pro" />
        <package android:name="org.uoyabause.urern" />
        <package android:name="io.mgba" />
        <package android:name="com.swordfish.lemuroid" />
        <package android:name="org.mupen64plusae.v3.fzurita.pro" />
        <package android:name="org.mupen64plusae.v3.fzurita" />
        <package android:name="it.dbtecno.pizzaboygbapro" />
        <package android:name="it.dbtecno.pizzaboygba" />
        <package android:name="it.dbtecno.pizzaboypro" />
        <package android:name="it.dbtecno.pizzaboy" />
        <package android:name="com.fastemulator.gba" />
        <package android:name="com.fastemulator.gbafree" />
        <package android:name="com.fastemulator.gbc" />
        <package android:name="com.fastemulator.gbcfree" />
        <package android:name="com.johnemulators.johnness" />
        <package android:name="com.johnemulators.johngbac" />
        <package android:name="bruenor.magicbox" />
        <package android:name="bruenor.magicbox.free" />
        <package android:name="ru.playsoftware.j2meloader" />
        <package android:name="org.easyrpg.player" />
        <package android:name="org.scummvm.scummvm" />
        <package android:name="org.openbor.engine" />
        <package android:name="com.winlator.cmod" />
        <package android:name="com.winlator.frost" />
        <package android:name="com.winlator" />
        <package android:name="com.micewine.emu" />
        <package android:name="com.xiaoji.egggame" />
        <package android:name="aenu.aps3e" />
        <package android:name="net.rpcs3.rpcs3" />
    </queries>

    <application
        android:name=".PocketDeckApp"
        android:allowBackup="true"
        android:label="@string/app_name"
        android:icon="@mipmap/ic_launcher"
        android:roundIcon="@mipmap/ic_launcher_round"
        android:supportsRtl="true"
        android:requestLegacyExternalStorage="true"
        android:theme="@style/Theme.PocketDeck"
        tools:targetApi="36">

        <activity
            android:name=".MainActivity"
            android:label="@string/app_name"
            android:exported="true"
            android:launchMode="singleTask"
            android:stateNotNeeded="true"
            android:resumeWhilePausing="true"
            android:configChanges="keyboard|keyboardHidden|navigation|orientation|screenSize|screenLayout|smallestScreenSize|uiMode|density"
            android:windowSoftInputMode="adjustResize">
            <!-- 作为桌面（Home screen）候选 -->
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.HOME" />
                <category android:name="android.intent.category.DEFAULT" />
            </intent-filter>
            <!-- 也在应用抽屉中显示，方便调试 -->
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
        </activity>

        <provider
            android:name="androidx.core.content.FileProvider"
            android:authorities="${applicationId}.fileprovider"
            android:exported="false"
            android:grantUriPermissions="true">
            <meta-data
                android:name="android.support.FILE_PROVIDER_PATHS"
                android:resource="@xml/file_paths" />
        </provider>
    </application>
</manifest>
