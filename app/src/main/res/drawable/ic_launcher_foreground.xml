<?xml version="1.0" encoding="utf-8"?>
<!--
  PocketDeck 旗舰极简几何标志（Luminous Deck Prism）：
  双层建筑感圆角叠卡（绯红珊瑚光影背卡 + 珍珠白前卡 + 精密切割 Play 棱角）
  所有顶点严格位于安全圆 66dp (21..87) 内，任意尺寸皆具备高辨识度与工业高级感。
-->
<vector xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:aapt="http://schemas.android.com/aapt"
    android:width="108dp"
    android:height="108dp"
    android:viewportWidth="108"
    android:viewportHeight="108">

    <!-- 后层绯红珊瑚叠卡（右下错位，呼应 Deck 层次） -->
    <path android:pathData="M 48,37 H 67 A 11,11 0 0,1 78,48 V 67 A 11,11 0 0,1 67,78 H 48 A 11,11 0 0,1 37,67 V 48 A 11,11 0 0,1 48,37 Z">
        <aapt:attr name="android:fillColor">
            <gradient
                android:type="linear"
                android:startX="37" android:startY="37"
                android:endX="78" android:endY="78"
                android:startColor="#FF6B5B"
                android:centerColor="#E62A42"
                android:endColor="#B5172E" />
        </aapt:attr>
    </path>

    <!-- 前层雕塑珍珠白主卡（左上错位，镂空中央 Play 棱角） -->
    <path
        android:fillType="evenOdd"
        android:pathData="
            M 41,29 H 59 A 11,11 0 0,1 70,40 V 59 A 11,11 0 0,1 59,70 H 41 A 11,11 0 0,1 30,59 V 40 A 11,11 0 0,1 41,29 Z
            M 45.2,43.2 Q 45.2,41.4 46.8,42.3 L 57.6,48.1 Q 59.2,49.5 57.6,50.9 L 46.8,56.7 Q 45.2,57.6 45.2,55.8 Z
        ">
        <aapt:attr name="android:fillColor">
            <gradient
                android:type="linear"
                android:startX="30" android:startY="29"
                android:endX="70" android:endY="70"
                android:startColor="#FFFFFF"
                android:endColor="#E9E7EF" />
        </aapt:attr>
    </path>
</vector>
